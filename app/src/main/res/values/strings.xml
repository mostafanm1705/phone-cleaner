    <!-- permissions -->
    <string name="perm_files_explain">To scan your phone storage and find junk, duplicates and blurry photos, the app needs \"All files access\". Tap the button, then turn on the switch for Phone Cleaner.</string>
    <string name="perm_privacy">Everything is analyzed on your phone. Nothing is uploaded, and nothing is deleted without your confirmation.</string>
    <string name="perm_usage_explain">To see which apps drain the battery, which apps you no longer use and how much cache each app keeps, allow \"Usage access\" for Phone Cleaner.</string>

