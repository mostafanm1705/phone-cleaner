    <!-- categories -->
    <string name="cat_junk">Junk files</string>
    <string name="cat_junk_desc">Temporary files, logs, thumbnail caches and empty files. Normal: phones collect these all the time. Deleting them is safe; thumbnails are rebuilt when needed.</string>
    <string name="cat_empty">Empty folders</string>
    <string name="cat_empty_desc">Folders with no files inside. Safe to delete; system folders are never listed.</string>
    <string name="cat_apks">APK files</string>
    <string name="cat_apks_desc">App installer files. If the app is already installed (same or newer version) the installer is no longer needed. Keep installers of apps you plan to install later.</string>
    <string name="cat_leftovers">Leftovers of removed apps</string>
    <string name="cat_leftovers_desc">Folders left behind by apps that are no longer installed. Big folders are not pre-selected because they may contain media you want to keep.</string>
    <string name="cat_duplicates">Duplicate files</string>
    <string name="cat_duplicates_desc">Files with exactly the same content. In each group one copy is marked \"Keep\" (the original) and the extra copies are pre-selected.</string>
    <string name="cat_similar">Similar photos</string>
    <string name="cat_similar_desc">Burst shots and near-identical photos. The sharpest photo of each group is kept; the others are pre-selected. Tap a photo to compare.</string>
    <string name="cat_blurry">Blurry photos</string>
    <string name="cat_blurry_desc">Photos with very little sharp detail (shaky, out of focus or pocket shots). Very blurry ones are pre-selected. Tap a photo to check it first; plain or dark photos can also appear here.</string>
    <string name="cat_lowres">Low quality photos</string>
    <string name="cat_lowres_desc">Small, pixelated images (under 0.3 megapixels), usually forwarded or downloaded copies.</string>
    <string name="cat_screenshots">Old screenshots</string>
    <string name="cat_screenshots_desc">Screenshots and screen recordings older than the age set in settings. Usually no longer needed.</string>
    <string name="cat_whatsapp">WhatsApp media</string>
    <string name="cat_whatsapp_desc">Photos, videos, voice notes and files received or sent on WhatsApp. Use the filters to clean one type at a time. Nothing is pre-selected.</string>
    <string name="cat_large">Large files</string>
    <string name="cat_large_desc">Files bigger than the size set in settings. Nothing is pre-selected; check what you no longer need.</string>

